# Server
NODE_ENV=development
PORT=8001
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net
DB_NAME=roomzy
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser clients allowed in production; comma-separated. Native apps need no entry.
CORS_ORIGIN=https://app.example.in

# Razorpay production credentials. Leave BOTH blank for local/mock payments;
# set both to charge real money (checkout + server-side signature verification).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Razorpay Dashboard > Settings > Webhooks). Point the
# webhook at POST /api/payments/webhook so payments reconcile even if the app
# closes before it confirms. Leave blank to disable the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Free trial (days) for new owners — their listings are live during this window.
LISTING_FREE_DAYS=7
# Owner subscription plan prices in INR. Every plan keeps all the owner's
# listings live AND includes the Verified Owner badge (no separate charge).
PLAN_1M_PRICE_INR=99
PLAN_3M_PRICE_INR=249
PLAN_6M_PRICE_INR=499
PLAN_12M_PRICE_INR=899
